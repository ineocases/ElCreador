// screens/sponsors.js
import gameState from '../engine/gameState.js';
import saveManager from '../engine/saveManager.js';
import { db } from '../firebase/firebase.js';
import { collection, getDocs } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

export const sponsorsScreen = {
    async render() {
        const container = document.getElementById('sponsorsContainer');
        if (!container) return;

        container.innerHTML = `
            <div style="max-width: 650px; margin: 30px auto; color: white; text-align: center; background: #121214; padding: 20px; border-radius: 12px; border: 1px solid #27272a;">
                <h2 style="color: #facc15;">💼 Contratos de Sponsorship</h2>
                <p>Conseguí patrocinadores oficiales para tu canal y cobrá dinero garantizado cada trimestre.</p>
                
                <div id="sponsorsList" style="margin: 20px 0; text-align: left;">Cargando ofertas de marcas...</div>
                
                <button onclick="window.location.hash = '#dashboard'" style="padding: 8px 16px; background: #27272a; color: white; border: none; cursor: pointer; border-radius: 6px;">Volver al Dashboard</button>
            </div>
        `;

        const listEl = document.getElementById('sponsorsList');
        try {
            const querySnapshot = await getDocs(collection(db, "sponsors_admin"));
            listEl.innerHTML = '';

            if (querySnapshot.empty) {
                listEl.innerHTML = '<p style="text-align:center; color:#a1a1aa;">No hay marcas registradas. Carga algunas desde el Panel Admin.</p>';
                return;
            }

            querySnapshot.forEach((docSnap) => {
                const data = docSnap.data();
                const canSign = gameState.player.subs >= data.minSubs;
                const isSigned = gameState.inventory.sponsors?.includes(data.name);

                const card = document.createElement('div');
                card.style.cssText = "background: #18181b; padding: 15px; margin-bottom: 12px; border-radius: 8px; border: 1px solid #27272a; display: flex; justify-content: space-between; align-items: center;";

                card.innerHTML = `
                    <div>
                        <strong style="font-size: 16px; color: #facc15;">${data.name}</strong><br>
                        <span style="font-size: 13px; color: #a1a1aa;">Pago: US$${data.pay.toLocaleString()} / trimestre</span><br>
                        <span style="font-size: 12px; color: ${canSign ? '#00ff88' : '#ef4444'};">Requerimiento: ${data.minSubs.toLocaleString()} subs</span>
                    </div>
                    <button class="btnSignSponsor" data-name="${data.name}" data-pay="${data.pay}" ${(!canSign || isSigned) ? 'disabled' : ''} 
                            style="padding: 8px 14px; background: ${isSigned ? '#3f3f46' : canSign ? '#facc15' : '#27272a'}; color: ${canSign && !isSigned ? 'black' : '#a1a1aa'}; font-weight: bold; border: none; border-radius: 6px; cursor: ${canSign && !isSigned ? 'pointer' : 'not-allowed'};">
                        ${isSigned ? 'Contratado' : 'Firmar Contrato'}
                    </button>
                `;
                listEl.appendChild(card);
            });

            document.querySelectorAll('.btnSignSponsor').forEach(btn => {
                btn.onclick = (e) => {
                    const name = e.target.getAttribute('data-name');
                    const pay = parseInt(e.target.getAttribute('data-pay'));

                    if (!gameState.inventory.sponsors) gameState.inventory.sponsors = [];
                    gameState.inventory.sponsors.push(name);
                    
                    // Cobro inmediato
                    gameState.player.money += pay;
                    saveManager.saveLocal();
                    saveManager.saveToFirebase();

                    alert(`¡Firmaste contrato con ${name}!\nRecibiste tu primer pago de US$${pay}.`);
                    this.render();
                };
            });

        } catch (e) {
            listEl.innerHTML = "Error al cargar sponsors.";
            console.error(e);
        }
    }
};
